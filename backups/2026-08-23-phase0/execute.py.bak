# -*- coding: utf-8 -*-
"""LLM 提案执行器：将老板审批后的交易计划写入 paper/paper.db

用法:
    python trading_team/execute.py                     # dry-run 预览最新决策（默认，不写库）
    python trading_team/execute.py 2026-08-22          # dry-run 预览指定日期
    python trading_team/execute.py 2026-08-22 --confirm  # 真正执行（写 paper.db / team.db）

规则（改进计划 Phase 0 起生效）:
    - 默认 dry-run；只有显式 --confirm 才写库
    - 执行前跑 consistency_check：同日多源冲突 → fail closed 拒绝执行
    - 只执行 decision.json 中 executable=true 的计划（审批已回写主事实源、
      market_ok 约束通过、position_pct 可解析）
    - pm_status 必须是 approved / partial；reduced 按计划仓位减半执行
    - 幂等：同一日期的 LLM 交易已写入则跳过
    - 收盘价成交、免手续费、无 T+1（v1 简化，Phase 1 接入撮合模型后移除）
    - 通过 trades.reason 标注 "LLM提案" 以区分策略交易
"""
import argparse
import json
import sqlite3
import sys
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(ROOT))

from trading_team.schemas import (  # noqa: E402
    SchemaError, is_buy, is_sell, parse_pct,
)
from trading_team import consistency_check  # noqa: E402

DECISIONS_DIR = ROOT / "trading_team" / "decisions"
DB = ROOT / "paper" / "paper.db"
INIT_CASH = 100_000.0


def _db():
    DB.parent.mkdir(exist_ok=True)
    conn = sqlite3.connect(DB)
    conn.executescript("""
    CREATE TABLE IF NOT EXISTS account(day TEXT PRIMARY KEY, cash REAL, equity REAL, note TEXT);
    CREATE TABLE IF NOT EXISTS positions(code TEXT PRIMARY KEY, qty REAL, avg_cost REAL);
    CREATE TABLE IF NOT EXISTS trades(id INTEGER PRIMARY KEY AUTOINCREMENT,
        day TEXT, code TEXT, side TEXT, qty REAL, price REAL, amount REAL, reason TEXT);
    """)
    if conn.execute("SELECT COUNT(*) FROM account").fetchone()[0] == 0:
        conn.execute("INSERT INTO account VALUES ('init', ?, ?, '初始资金')",
                     (INIT_CASH, INIT_CASH))
        conn.commit()
    return conn


def load_decision(day):
    path = DECISIONS_DIR / day / "decision.json"
    if not path.exists():
        return None
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def load_close_price(code, day):
    """从 bundle 加载指定股票指定日期的收盘价。简化：尝试 kde_levels bundle。"""
    sys.path.insert(0, str(ROOT / "kde_levels"))
    try:
        from levels import BundleData  # noqa: E402
        bd = BundleData()
        for suffix in [".XSHG", ".XSHE", ""]:
            try:
                df = bd.load(f"{code}{suffix}")
                if day in df.index.strftime("%Y-%m-%d").values:
                    return float(df.loc[df.index.strftime("%Y-%m-%d") == day, "close"].iloc[0])
                # 回退到最新可用价格（Phase 1 前保留，复盘时注意口径）
                return float(df["close"].iloc[-1])
            except Exception:
                continue
    except Exception:
        pass
    return None


def execute(day=None, confirm=False):
    """执行（或 dry-run 预览）某日的已审批决策。返回是否成功。"""
    if day is None:
        dates = sorted([d.name for d in DECISIONS_DIR.iterdir() if d.is_dir()], reverse=True)
        if not dates:
            print("无决策文件")
            return False
        day = dates[0]

    mode = "EXECUTE" if confirm else "DRY-RUN"
    print(f"[{day}] [{mode}] 加载决策...")

    # ── 前置门禁 1：多源一致性（fail closed）─────────────────────
    check = consistency_check.check_day(day)
    for c in check["conflicts"]:
        print(f"  [冲突] {c}")
    for w in check["warnings"]:
        print(f"  [警告] {w}")
    if not check["ok"]:
        print(f"  ❌ 一致性校验未通过（{len(check['conflicts'])} 项冲突），拒绝执行")
        return False

    dec = load_decision(day)
    if dec is None:
        print(f"  决策文件不存在: {DECISIONS_DIR / day / 'decision.json'}")
        return False

    # ── 前置门禁 2：pm_status ────────────────────────────────────
    if dec.get("pm_status") not in ("approved", "partial"):
        print(f"  状态={dec.get('pm_status')}，未审批完成，跳过")
        return False

    conn = _db()

    # 幂等检查：该日期是否已有 LLM 交易记录
    if confirm and conn.execute(
        "SELECT 1 FROM trades WHERE day=? AND reason LIKE 'LLM提案%' LIMIT 1", (day,)
    ).fetchone():
        print(f"  {day} 已有 LLM 交易记录，幂等跳过")
        conn.close()
        return True

    last = conn.execute(
        "SELECT cash, equity FROM account ORDER BY rowid DESC LIMIT 1"
    ).fetchone()
    cash = last[0]
    positions = {
        r[0]: {"qty": r[1], "cost": r[2]}
        for r in conn.execute("SELECT code, qty, avg_cost FROM positions")
    }

    plans = dec.get("plans", [])
    if not plans:
        print("  无交易计划")
        conn.close()
        return True

    trades = []

    for plan in plans:
        code = str(plan.get("code", ""))
        name = plan.get("name", "")
        direction = str(plan.get("direction", ""))
        stop = plan.get("stop")
        confidence = plan.get("confidence", 0)
        approval = plan.get("approval", "pending")

        if not code:
            continue

        # ── 前置门禁 3：per-plan 可执行性（主事实源已计算 executable）──
        if not plan.get("executable", False):
            print(f"  ⏭️ {code} {name} 不可执行: approval={approval}, "
                  f"blocked={plan.get('blocked_reason') or '未批准'}")
            continue

        # 仓位解析（严格；reduced 减半）
        try:
            pos_pct = parse_pct(plan.get("position_pct"))
        except SchemaError as e:
            print(f"  ❌ {code} 仓位解析失败: {e}，跳过（fail closed）")
            continue
        if approval == "reduced":
            pos_pct = pos_pct / 2.0

        buy = is_buy(direction, pos_pct)
        sell = is_sell(direction)
        hold = "持有" in direction

        price = load_close_price(code, day)
        if price is None:
            print(f"  ⚠️ {code} 无法获取收盘价，跳过")
            continue

        cur_qty = positions.get(code, {}).get("qty", 0)

        if sell and cur_qty > 0:
            qty = cur_qty
            amt = qty * price
            cash += amt
            trades.append((day, code, "sell", qty, price, amt,
                          f"LLM提案: {name} {direction} 信心{confidence}"))
            del positions[code]
            print(f"  卖出 {code} ×{qty} @ {price:.2f} = ¥{amt:,.0f}")

        elif buy and pos_pct > 0:
            total_val = cash
            for c, p in positions.items():
                p_price = price if c == code else load_close_price(c, day)
                if p_price:
                    total_val += p["qty"] * p_price

            target_val = total_val * pos_pct
            target_qty = int(target_val / price / 100) * 100

            if target_qty <= 0:
                print(f"  {code} 目标仓位计算为 0，跳过")
                continue

            diff_qty = target_qty - cur_qty
            if diff_qty > 0:
                buy_qty = diff_qty
                buy_amt = buy_qty * price
                if buy_amt > cash:
                    print(f"  ⚠️ {code} 现金不足: 需 ¥{buy_amt:,.0f}, 有 ¥{cash:,.0f}, 按可用现金调整")
                    buy_qty = int(cash / price / 100) * 100
                    if buy_qty <= 0:
                        continue
                    buy_amt = buy_qty * price
                cash -= buy_amt
                old = positions.get(code, {"qty": 0, "cost": 0})
                new_qty = old["qty"] + buy_qty
                positions[code] = {
                    "qty": new_qty,
                    "cost": (old["qty"] * old["cost"] + buy_qty * price) / new_qty
                }
                label = "加仓" if old["qty"] > 0 else "开仓"
                trades.append((day, code, "buy", buy_qty, price, buy_amt,
                              f"LLM提案: {name} {label}至{pos_pct*100:.0f}% 信心{confidence}"))
                print(f"  买入 {code} ×{buy_qty} @ {price:.2f} = ¥{buy_amt:,.0f} ({label})")
            elif diff_qty < 0:
                sell_qty = min(abs(diff_qty), cur_qty)
                sell_amt = sell_qty * price
                cash += sell_amt
                positions[code]["qty"] -= sell_qty
                if positions[code]["qty"] == 0:
                    del positions[code]
                trades.append((day, code, "sell", sell_qty, price, sell_amt,
                              f"LLM提案: {name} 减仓至{pos_pct*100:.0f}% 信心{confidence}"))
                print(f"  卖出 {code} ×{sell_qty} @ {price:.2f} = ¥{sell_amt:,.0f} (减仓)")
            else:
                print(f"  {code} 仓位已达标，不动")

        elif hold and cur_qty > 0:
            print(f"  {code} 持有不动")

        else:
            print(f"  {code} 方向={direction}, 不操作")

    if not confirm:
        # dry-run：不写任何库，仅汇总
        total_equity = cash
        for c, p in positions.items():
            p_price = load_close_price(c, day)
            if p_price:
                total_equity += p["qty"] * p_price
        conn.close()
        print(f"\n[DRY-RUN] {day} 预览完成: 拟交易 {len(trades)} 笔, "
              f"cash=¥{cash:,.2f}, equity=¥{total_equity:,.2f}")
        print("  （加 --confirm 才会写入 paper.db / team.db）")
        return True

    # ── 写库（confirm 模式）──────────────────────────────────────
    for t in trades:
        conn.execute(
            "INSERT INTO trades(day,code,side,qty,price,amount,reason) VALUES (?,?,?,?,?,?,?)",
            t
        )
    conn.execute("DELETE FROM positions")
    conn.executemany(
        "INSERT INTO positions VALUES (?,?,?)",
        [(c, p["qty"], p["cost"]) for c, p in positions.items()]
    )
    total_equity = cash
    for c, p in positions.items():
        p_price = load_close_price(c, day)
        if p_price:
            total_equity += p["qty"] * p_price

    note = f"LLM提案执行 {len(trades)} 笔" if trades else "LLM提案: 无交易"
    conn.execute("INSERT OR REPLACE INTO account VALUES (?,?,?,?)",
                 (day, round(cash, 2), round(total_equity, 2), note))
    conn.commit()
    conn.close()

    print(f"\n✅ {day} 执行完成: cash=¥{cash:,.2f}, equity=¥{total_equity:,.2f}, trades={len(trades)}")

    # ── 写入 team.db 执行日志 ───────────────────────────────
    TEAM_DB = ROOT / "trading_team" / "team.db"
    if TEAM_DB.exists():
        tconn = sqlite3.connect(TEAM_DB)
        for t in trades:
            tconn.execute("""
                INSERT INTO execution_log
                (decision_date, code, side, qty, price, amount, reason)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            """, t)
        executed_at = datetime.now().isoformat()
        result_summary = f"执行{len(trades)}笔,cash={cash:.2f},equity={total_equity:.2f}"
        tconn.execute("""
            UPDATE decisions
            SET executed_at = ?, execution_result = ?
            WHERE date = ?
        """, (executed_at, result_summary, day))
        tconn.commit()
        tconn.close()
        print(f"  [team.db] 已记录执行日志 {len(trades)} 条")

    return True


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="LLM 提案执行器（默认 dry-run）")
    ap.add_argument("day", nargs="?", default=None, help="决策日期 YYYY-MM-DD")
    ap.add_argument("--confirm", action="store_true", help="真正写库执行")
    args = ap.parse_args()
    ok = execute(args.day, confirm=args.confirm)
    sys.exit(0 if ok else 1)
